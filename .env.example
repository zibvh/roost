# Rooster App — Environment Variables
# Copy this to .env for local dev. Set these in your hosting/build settings for production.

# Your deployed Node.js server URL (no trailing slash)
# e.g. https://rooster-server.onrender.com
VITE_SERVER_URL=http://localhost:3000

# The same APP_SECRET value set on your server — keeps random people off your endpoint
VITE_APP_SECRET=replace_with_same_secret_as_server
